model PaymentTaken {
  id String @id @default(uuid())

  paymentCycleId String
  paymentCycle   PaymentCycle @relation(fields: [paymentCycleId], references: [id])

  amount  Int
  takenAt DateTime @default(now())
  note    String
}

model Attendance {
  id String @id @default(uuid())

  instructorId String

  date   DateTime
  status AttendanceStatus @default(NOT_TAKEN)

  note String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instructorId, date])
  @@index([date])
}

enum AttendanceStatus {
  NOT_TAKEN
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

model Car {
  id                  String   @id @default(uuid())
  name                String
  transmission        String
  assigned_instructor String
  car_year            String
  car_Number          String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SetupChecklist {
  id              String   @id @default(uuid())
  schoolSetup     Boolean  @default(false)
  instructorSetup Boolean  @default(false)
  carSetup        Boolean  @default(false)
  packageSetup    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Instructor {
  id     String @id @default(uuid())
  name   String
  mobile String

  licenseNumber String?
  jobType       JobType   @default(INSTRUCTOR)
  joiningDate   DateTime?
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentCycles PaymentCycle[]
}

enum JobType {
  INSTRUCTOR
  RECEPTION
}

model Package {
  id       String  @id @default(uuid())
  name     String
  price    Decimal
  duration Int
  isActive Boolean @default(true)
}

model PaymentCycle {
  id String @id @default(uuid())

  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id])

  month         DateTime
  amountTaken   Int            @default(0)
  // Payment
  baseAmount    Int
  deductions    Int
  bonus         Int
  netAmount     Int
  paidAt        DateTime
  note          String
  status        PaymentStatus  @default(PENDING)
  paymentsTaken PaymentTaken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instructorId, month])
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model Schedule {
  id            String @id @default(uuid())
  student_id    String
  Batch_time    String
  Duration_time String
  Car_id        String
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../main/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model SchoolSetUp {
  id             String   @id @default(uuid())
  systemId       String?
  school_name    String
  support_Email  String
  address        String
  contact_Number String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Student {
  id     String @id @default(uuid())
  name   String
  mobile String
  email  String

  packageId         String?
  package_name      String?
  Enrollment_status Enrollment_status @default(CHOSEN)
  Course_Start_date DateTime?
  Course_End_Date   DateTime?

  Assigned_Instructor String?

  Total_amount         Int
  Amount_paid          Int
  Remaining_percentage Int
  remaining_amount     Int

  //Whatsapp automation 

  Thank_you_msg          String
  Welcome_msg            String
  Remainder_msg          String
  Balance_remaining_date DateTime?

  Assigned_car_id String

  // Timestamp
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Enrollment_status {
  ENQUIRY
  CHOSEN
}
